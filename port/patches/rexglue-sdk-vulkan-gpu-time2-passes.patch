+void VulkanCommandProcessor::MarkGpuPass(GpuPass pass) {
+  if (gpu_pass_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  ++gpu_pass_draws_[pass];
+  if (pass == gpu_pass_current_) {
+    return;
+  }
+  // The deferred command buffer is reset when a submission begins, so it has to be open already.
+  if (!submission_open_ && !BeginSubmission(true)) {
+    return;
+  }
+  const uint64_t submission = GetCurrentSubmission();
+  const uint32_t slice_index = uint32_t(submission % kGpuPassSlices);
+  GpuPassSlice& slice = gpu_pass_slices_[slice_index];
+  if (slice.submission != submission) {
+    slice.submission = submission;
+    slice.count = 0;
+  }
+  // Keep room for the end timestamp written in EndSubmission.
+  if (slice.count + 3 >= kGpuPassMarksPerSlice) {
+    return;
+  }
+  deferred_command_buffer_.CmdVkWriteTimestamp(
+      VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_pass_pool_,
+      slice_index * kGpuPassMarksPerSlice + 1 + slice.count);
+  slice.tags[slice.count++] = uint8_t(gpu_pass_current_);
+  gpu_pass_current_ = pass;
+}
