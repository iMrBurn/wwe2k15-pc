+namespace {
+// Titles can sample the same rejected fetch constant on every draw (WWE 2K15 logged ~16000
+// warnings per match, rotating the log and costing CPU). Report each distinct constant once.
+bool ShouldLogRejectedFetchConstant(const xenos::xe_gpu_texture_fetch_t& fetch) {
+  constexpr size_t kMaxDistinct = 256;
+  static std::mutex mutex;
+  static std::unordered_set<uint64_t> seen;
+  uint64_t key = 0xCBF29CE484222325ull;
+  for (uint32_t dword : {fetch.dword_0, fetch.dword_1, fetch.dword_2, fetch.dword_3,
+                         fetch.dword_4, fetch.dword_5}) {
+    key = (key ^ dword) * 0x100000001B3ull;
+  }
+  std::lock_guard<std::mutex> lock(mutex);
+  if (seen.size() >= kMaxDistinct) {
+    return false;
+  }
+  if (!seen.insert(key).second) {
+    return false;
+  }
+  if (seen.size() == kMaxDistinct) {
+    REXGPU_WARN("Further rejected texture fetch constants will not be logged");
+  }
+  return true;
+}
