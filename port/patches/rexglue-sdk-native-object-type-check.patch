+object_ref<XObject> XObject::GetNativeObjectOfType(KernelState* kernel_state, void* native_ptr,
+                                                   int32_t as_type, Type expected) {
+  auto object = GetNativeObject(kernel_state, native_ptr, as_type);
+  if (!object || object->type() == expected) {
+    return object;
+  }
+  auto header = reinterpret_cast<X_DISPATCH_HEADER*>(native_ptr);
+  static std::atomic<uint32_t> logged{0};
+  if (logged.fetch_add(1, std::memory_order_relaxed) < 16) {
+    REXSYS_WARN("GetNativeObject: guest object (dispatch type {}) holds a {} where a {} was "
+                "expected, re-creating it",
+                uint32_t(header->type), object->type(), expected);
+  }
+  // Only the dispatcher objects GetNativeObject creates can be re-made from the guest struct.
+  if (expected != Type::Event && expected != Type::Semaphore && expected != Type::Mutant) {
+    return nullptr;
+  }
+  {
+    auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+    header->wait_list_flink = 0;
+  }
+  object = GetNativeObject(kernel_state, native_ptr, as_type);
+  return object && object->type() == expected ? object : nullptr;
+}
+
 }  // namespace rex::system
