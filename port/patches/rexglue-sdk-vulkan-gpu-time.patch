+void VulkanCommandProcessor::ReadGpuTimestamps(uint64_t first_submission,
+                                               uint64_t last_submission) {
+  if (gpu_timestamp_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (uint64_t submission = first_submission; submission <= last_submission; ++submission) {
+    uint32_t slot = uint32_t(submission % kGpuTimestampSlots);
+    if (gpu_timestamp_submission_[slot] != submission) {
+      continue;
+    }
+    uint64_t ticks[2];
+    if (dfn.vkGetQueryPoolResults(device, gpu_timestamp_pool_, slot * 2, 2, sizeof(ticks), ticks,
+                                  sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) == VK_SUCCESS &&
+        ticks[1] >= ticks[0]) {
+      gpu_busy_ns_ += double(ticks[1] - ticks[0]) * gpu_timestamp_ns_per_tick_;
+      ++gpu_timed_submissions_;
+    }
+  }
+  auto now = std::chrono::steady_clock::now();
+  double seconds = std::chrono::duration<double>(now - gpu_time_log_start_).count();
+  if (seconds < 5.0) {
+    return;
+  }
+  double busy_ms = gpu_busy_ns_ / 1.0e6;
+  REXGPU_INFO("GPU time: busy {:.0f}% of {:.1f} s, {:.1f} ms per presented frame ({} frames, {} "
+              "submissions)",
+              busy_ms / (seconds * 10.0), seconds,
+              gpu_presented_frames_ ? busy_ms / gpu_presented_frames_ : 0.0, gpu_presented_frames_,
+              gpu_timed_submissions_);
+  gpu_busy_ns_ = 0.0;
+  gpu_timed_submissions_ = 0;
+  gpu_presented_frames_ = 0;
+  gpu_time_log_start_ = now;
+}
