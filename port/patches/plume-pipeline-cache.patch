+    static std::string g_pipelineCacheDirectory;
+
+    void setVulkanPipelineCacheDirectory(const char *directory) {
+        g_pipelineCacheDirectory = directory ? directory : "";
+    }
+
+    // The driver validates the blob's header and ignores data from another device or driver version; the file
+    // name carries the pipeline cache UUID so a different GPU or driver reads its own file (or none).
+    void VulkanDevice::loadPipelineCache() {
+        std::vector<char> data;
+        if (!g_pipelineCacheDirectory.empty()) {
+            char uuid[2 * VK_UUID_SIZE + 1];
+            for (uint32_t i = 0; i < VK_UUID_SIZE; i++) {
+                snprintf(uuid + 2 * i, 3, "%02x", physicalDeviceProperties.pipelineCacheUUID[i]);
+            }
+            std::error_code error;
+            std::filesystem::create_directories(g_pipelineCacheDirectory, error);
+            pipelineCachePath = (std::filesystem::path(g_pipelineCacheDirectory) / (std::string(uuid) + ".vk.pcache")).string();
+            std::ifstream file(pipelineCachePath, std::ios::binary | std::ios::ate);
+            if (file) {
+                const std::streamsize size = file.tellg();
+                if (size > 0 && size < (std::streamsize(1) << 30)) {
+                    data.resize(size_t(size));
+                    file.seekg(0);
+                    if (!file.read(data.data(), size)) {
+                        data.clear();
+                    }
+                }
+            }
+        }
+
+        VkPipelineCacheCreateInfo createInfo = {};
+        createInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+        createInfo.initialDataSize = data.size();
+        createInfo.pInitialData = data.empty() ? nullptr : data.data();
+        if (vkCreatePipelineCache(vk, &createInfo, nullptr, &pipelineCache) != VK_SUCCESS && !data.empty()) {
+            // Refused (corrupt or foreign blob): start empty.
+            createInfo.initialDataSize = 0;
+            createInfo.pInitialData = nullptr;
+            if (vkCreatePipelineCache(vk, &createInfo, nullptr, &pipelineCache) != VK_SUCCESS) {
+                pipelineCache = VK_NULL_HANDLE;
+            }
+        }
+        else if (!data.empty()) {
+            fprintf(stderr, "Vulkan pipeline cache loaded (%zu KB).\n", data.size() >> 10);
+        }
+
+        pipelineCacheLastSaveMs.store(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+    }
+
+    void VulkanDevice::savePipelineCache(bool force) {
+        if (pipelineCache == VK_NULL_HANDLE || pipelineCachePath.empty()) {
+            return;
+        }
+
+        const uint32_t unsaved = pipelineCacheUnsaved.load(std::memory_order_relaxed);
+        if (unsaved == 0) {
+            return;
+        }
+
+        const int64_t nowMs = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        if (!force && (unsaved < 16 || nowMs - pipelineCacheLastSaveMs.load() < 30000)) {
+            return;
+        }
+
+        std::unique_lock<std::mutex> lock(pipelineCacheSaveMutex, std::try_to_lock);
+        if (!lock.owns_lock()) {
+            return;
+        }
+
+        size_t size = 0;
+        if (vkGetPipelineCacheData(vk, pipelineCache, &size, nullptr) != VK_SUCCESS || size == 0) {
+            return;
+        }
+
+        std::vector<char> data(size);
+        const VkResult res = vkGetPipelineCacheData(vk, pipelineCache, &size, data.data());
+        if (res != VK_SUCCESS && res != VK_INCOMPLETE) {
+            return;
+        }
+
+        data.resize(size);
+        const std::string tempPath = pipelineCachePath + ".tmp";
+        {
+            std::ofstream file(tempPath, std::ios::binary | std::ios::trunc);
+            if (!file.write(data.data(), std::streamsize(data.size()))) {
+                return;
+            }
+        }
+
+        std::error_code error;
+        std::filesystem::rename(tempPath, pipelineCachePath, error);
+        if (error) {
+            std::filesystem::remove(pipelineCachePath, error);
+            std::filesystem::rename(tempPath, pipelineCachePath, error);
+        }
+
+        pipelineCacheUnsaved.store(0, std::memory_order_relaxed);
+        pipelineCacheLastSaveMs.store(nowMs);
+        fprintf(stderr, "Vulkan pipeline cache saved (%zu KB); %u pipelines created by the driver this run, %llu ms in total.\n", data.size() >> 10,
+            pipelineCreateCount.load(), (unsigned long long)(pipelineCreateMicros.load() / 1000));
     }
 
