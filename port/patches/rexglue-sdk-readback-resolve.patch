+namespace {
+// readback_resolve_stats (GPU thread only).
+struct ResolveStat {
+  uint32_t format = 0, count = 0, reads = 0;
+};
+std::unordered_map<uint64_t, ResolveStat> g_resolve_stats;
+uint64_t g_resolve_stats_start = 0;
+bool g_resolve_last_read = false;
+uint32_t g_resolve_last_address = 0, g_resolve_last_length = 0;
+
+void RecordResolveStat(uint64_t frame, uint32_t format, uint32_t address, uint32_t length,
+                       bool read) {
+  if (!REXCVAR_GET(readback_resolve_stats)) {
+    return;
+  }
+  if (length) {
+    ResolveStat& stat = g_resolve_stats[uint64_t(address) | (uint64_t(length) << 32)];
+    stat.format = format;
+    ++stat.count;
+    stat.reads += read ? 1 : 0;
+  }
+  if (frame - g_resolve_stats_start < 300) {
+    return;
+  }
+  std::vector<std::pair<uint64_t, ResolveStat>> top(g_resolve_stats.begin(), g_resolve_stats.end());
+  std::sort(top.begin(), top.end(),
+            [](const auto& a, const auto& b) { return a.second.count > b.second.count; });
+  uint32_t total = 0, reads = 0;
+  for (const auto& t : top) {
+    total += t.second.count;
+    reads += t.second.reads;
+  }
+  std::string list;
+  for (size_t i = 0; i < top.size() && i < 12; ++i) {
+    list += fmt::format(" [f{} {}B @{:08X} x{} r{}]", top[i].second.format, uint32_t(top[i].first >> 32),
+                        uint32_t(top[i].first), top[i].second.count, top[i].second.reads);
+  }
+  REXGPU_INFO("Resolve stats over {} frames: {} resolves, {} read back:{}",
+              frame - g_resolve_stats_start, total, reads, list);
+  g_resolve_stats.clear();
+  g_resolve_stats_start = frame;
+}
