+bool VulkanCommandProcessor::ReadbackResolveFormatSelected() const {
+  const std::string& formats = REXCVAR_GET(readback_resolve_formats);
+  if (formats.empty()) {
+    return true;
+  }
+  const uint32_t format =
+      uint32_t(register_file_->Get<reg::RB_COPY_DEST_INFO>().copy_dest_format);
+  size_t at = 0;
+  while (at < formats.size()) {
+    size_t end = formats.find(',', at);
+    if (end == std::string::npos) {
+      end = formats.size();
+    }
+    if (uint32_t(std::strtoul(formats.c_str() + at, nullptr, 10)) == format) {
+      return true;
+    }
+    at = end + 1;
+  }
+  return false;
+}
